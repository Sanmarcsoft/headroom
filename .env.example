# Copy this file to .env and fill in real values before running in production.
# IMPORTANT: Change NEO4J_AUTH before deploying — default credentials are insecure.
NEO4J_AUTH=neo4j/CHANGEME

# Bearer token required from non-loopback callers of the proxy's /v1/* data
# plane (chat completions, responses, etc). Loopback callers (127.0.0.1,
# ::1, localhost) are always exempt, so the default docker-compose.yml quick
# start (which publishes port 8787 on 127.0.0.1 only) works with this unset.
# Set this BEFORE widening the compose file's port publish address (e.g.
# changing "127.0.0.1:8787:8787" to "8787:8787") to expose the proxy to
# another machine, otherwise the data plane is reachable with NO
# authentication. Send it as `Authorization: Bearer <token>`.
# HEADROOM_PROXY_TOKEN=CHANGEME
