# Copy to .env and adjust. `.env` is gitignored; this file is the template.

# Image to run. Pinned to an immutable digest, never a rolling tag.
#
# This is the published multi-arch image (linux/amd64 + linux/arm64) built by CI
# from a reviewed commit on main. Prefer it over a local build: an image built on
# one host exists only on that host, so the sidecar does not come back after a
# host rebuild, which is the failure this deployment exists to remove.
#
# The package is private, so authenticate once on the Docker host first:
#   docker login ghcr.io -u <github-user>    # token needs read:packages
HEADROOM_IMAGE=ghcr.io/sanmarcsoft/headroom@sha256:d5af8c293189ce19ddbb11a77f9332f94bee5463d5ff0f6036af6e6f374636d5

# Alternative, for iterating on an unmerged change: build.sh builds from the
# working tree and prints a `sanmarcsoft/headroom:git-<sha>` value to paste here.
# That image is local only, so treat it as temporary and return to a digest.

# The user-defined bridge network the code-server container is already on.
# Find it with:
#   docker inspect code-server \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
CODE_SERVER_NETWORK=roo-dev_default

# Proxy tuning.
#
# Leave HEADROOM_MODE on `cache` unless you have measured a reason not to. It
# freezes prior turns so the provider's prefix cache keeps hitting. `token`
# rewrites them for a little extra compression and destroys those hits, which
# inflates the token count a coding agent uses to decide when to compact its
# context and sends it into a compaction loop. See the comment in
# docker-compose.yml for the incident. This file previously shipped `token`;
# that was the bug.
HEADROOM_MODE=cache
HEADROOM_BACKEND=anthropic
