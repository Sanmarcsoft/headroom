# Copy to .env and adjust. `.env` is gitignored; this file is the template.

# Image to run. Pinned to a git SHA, never a rolling tag.
# build.sh prints the exact value to paste here.
HEADROOM_IMAGE=sanmarcsoft/headroom:git-3e134bb0

# The user-defined bridge network the code-server container is already on.
# Find it with:
#   docker inspect code-server \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
CODE_SERVER_NETWORK=roo-dev_default

# Proxy tuning. Defaults match the native runtime this sidecar replaces.
HEADROOM_MODE=token
HEADROOM_BACKEND=anthropic
